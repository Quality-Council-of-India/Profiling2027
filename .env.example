# Used by docker-compose.yml for production deployment.
# Copy to `.env` in the repo root and fill in real values before `docker compose up`.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://feedback.qcin.org

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Profiling 2027 Feedback Portal <no-reply@qcin.org>

REMINDER_CRON=0 10 * * *
