DATABASE_URL="postgresql://postgres:postgres@localhost:5432/profiling2027?schema=public"
# On a pooled host (Neon, Vercel Postgres, Supabase), DATABASE_URL should be
# the pooled connection string and DIRECT_URL the unpooled one — Prisma uses
# `url` at runtime and `directUrl` for `prisma migrate deploy`. On a plain
# unpooled Postgres (e.g. Docker Compose), both can be the same value.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/profiling2027?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
PORT=4000
NODE_ENV=production
CORS_ORIGIN="https://feedback.qcin.org"

# SMTP (Nodemailer) — used for compliance reminder emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Profiling 2027 Feedback Portal <no-reply@qcin.org>"

# Auto-reminder cron (node-cron syntax): fires daily; job checks "day 2 of window"
REMINDER_CRON="0 10 * * *"
