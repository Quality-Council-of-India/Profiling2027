// Profiling 2027 Feedback Portal — Database Schema
// Mirrors Technical Specification v3, Section 3 (Database Schema)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"] // rhel-openssl-3.0.x = Vercel's Node function runtime
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (via PgBouncer/Neon's pooler) — used at runtime
  directUrl = env("DIRECT_URL")   // unpooled connection — used for `prisma migrate deploy`
}

enum Role {
  profiler
  group_anchor
  casu_anchor
  casu_lead
  project_lead
  admin
}

enum MappingType {
  peer
}

enum WeekStatus {
  upcoming
  open
  closed
}

enum EvalType {
  self
  peer
}

enum ProblemSolving {
  satisfied
  not_satisfied
}

enum TicketCategory {
  password_email_change
  portal_bug
  feature_not_working
  other
}

enum TicketStatus {
  open
  in_progress
  resolved
}

enum NotificationType {
  ticket_created
  ticket_resolved
  week_opened
  week_closed
}

// 3.1.1 projects — one record per annual cycle (Padma 2027, Padma 2028, ...)
model Project {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  year        Int       @unique
  start_date  DateTime  @db.Date
  end_date    DateTime? @db.Date
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())

  users         User[]
  weeks         Week[]
  peer_mappings PeerMapping[]
  tickets       Ticket[]
  notifications Notification[]

  @@map("projects")
}

// 3.1.2 users — every professional, lead, anchor, and admin
model User {
  id            Int      @id @default(autoincrement())
  project_id    Int
  name          String   @db.VarChar(100)
  email         String   @unique @db.VarChar(150)
  password_hash String   @db.VarChar(255)
  role          Role
  field         String?  @db.VarChar(50)
  photo_url     String?  @db.VarChar(500)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  mappingsAsEvaluator PeerMapping[]    @relation("MappingEvaluator")
  mappingsAsEvaluatee PeerMapping[]    @relation("MappingEvaluatee")
  evaluationsGiven    Evaluation[]     @relation("EvalEvaluator")
  evaluationsReceived Evaluation[]     @relation("EvalEvaluatee")
  computedScores      ComputedScore[]
  tickets             Ticket[]
  notifications       Notification[]

  @@index([project_id])
  @@map("users")
}

// 3.1.3 peer_mappings — who evaluates whom (digital 'Ideal Mapping' tab)
model PeerMapping {
  id            Int         @id @default(autoincrement())
  project_id    Int
  evaluator_id  Int
  evaluatee_id  Int
  mapping_type  MappingType @default(peer)

  project  Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  evaluator User   @relation("MappingEvaluator", fields: [evaluator_id], references: [id], onDelete: Cascade)
  evaluatee User   @relation("MappingEvaluatee", fields: [evaluatee_id], references: [id], onDelete: Cascade)

  @@unique([project_id, evaluator_id, evaluatee_id])
  @@index([evaluatee_id])
  @@map("peer_mappings")
}

// 3.1.4 weeks — each feedback cycle; admin opens/closes
model Week {
  id          Int        @id @default(autoincrement())
  project_id  Int
  week_number Int
  label       String     @db.VarChar(20)
  start_date  DateTime   @db.Date
  end_date    DateTime   @db.Date
  status      WeekStatus @default(upcoming)

  project     Project        @relation(fields: [project_id], references: [id], onDelete: Cascade)
  evaluations Evaluation[]
  scores      ComputedScore[]

  @@unique([project_id, week_number])
  @@map("weeks")
}

// 3.1.5 evaluations — one row per form submission (self or single peer eval)
model Evaluation {
  id               Int            @id @default(autoincrement())
  week_id          Int
  evaluator_id     Int
  evaluatee_id     Int
  eval_type        EvalType
  sincerity        Int            @db.SmallInt
  team_spirit      Int            @db.SmallInt
  knowledge        Int            @db.SmallInt
  quantity         Int            @db.SmallInt
  quality          Int            @db.SmallInt
  problem_solving  ProblemSolving
  problem_reason   String?
  strengths_tags   String[]
  weakness_tags    String[]
  strength_comment String?
  weakness_comment String?
  submitted_at     DateTime       @default(now())
  locked           Boolean        @default(true)

  week      Week @relation(fields: [week_id], references: [id], onDelete: Cascade)
  evaluator User @relation("EvalEvaluator", fields: [evaluator_id], references: [id], onDelete: Cascade)
  evaluatee User @relation("EvalEvaluatee", fields: [evaluatee_id], references: [id], onDelete: Cascade)

  // one row per (week, evaluator, evaluatee, type) — enforced by the DB, not just app
  // logic, so it can never be duplicated even under concurrent submissions. Every
  // successful write re-locks the row; only an Admin unlock (locked=false) permits
  // the evaluator to submit an edit, which then re-locks it immediately.
  @@unique([week_id, evaluator_id, evaluatee_id, eval_type])
  @@index([week_id, evaluatee_id])
  @@map("evaluations")
}

// 3.1.6 computed_scores — materialised weekly scores, replaces 'Scores for Week XX' tabs
model ComputedScore {
  id                   Int      @id @default(autoincrement())
  week_id              Int
  user_id              Int
  sincerity_self       Decimal  @default(0) @db.Decimal(3, 2)
  sincerity_peer       Decimal  @default(0) @db.Decimal(3, 2)
  team_spirit_self     Decimal  @default(0) @db.Decimal(3, 2)
  team_spirit_peer     Decimal  @default(0) @db.Decimal(3, 2)
  knowledge_self       Decimal  @default(0) @db.Decimal(3, 2)
  knowledge_peer       Decimal  @default(0) @db.Decimal(3, 2)
  quantity_self        Decimal  @default(0) @db.Decimal(3, 2)
  quantity_peer        Decimal  @default(0) @db.Decimal(3, 2)
  quality_self         Decimal  @default(0) @db.Decimal(3, 2)
  quality_peer         Decimal  @default(0) @db.Decimal(3, 2)
  total_self           Decimal  @default(0) @db.Decimal(4, 2)
  total_peer           Decimal  @default(0) @db.Decimal(5, 2)
  peer_count           Int      @default(0)
  expected_peer_count  Int      @default(0)
  sapa_factor          Decimal? @db.Decimal(4, 3)
  computed_at          DateTime @default(now())

  week Week @relation(fields: [week_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([week_id, user_id])
  @@map("computed_scores")
}

// Grievance Redressal — "Raise Your Concern" tickets any non-admin user can
// file (password/email changes, portal bugs, feature issues, or anything
// else); Admin triages and responds from the Grievances tab.
model Ticket {
  id             Int            @id @default(autoincrement())
  project_id     Int
  user_id        Int
  category       TicketCategory
  subject        String         @db.VarChar(200)
  description    String
  status         TicketStatus   @default(open)
  admin_response String?
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  resolved_at    DateTime?

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([project_id, status])
  @@index([user_id])
  @@map("tickets")
}

// Bell-icon notifications — Admin gets one per new ticket, everyone gets one
// when a week opens/closes, and a ticket's filer gets one when it's resolved.
model Notification {
  id         Int              @id @default(autoincrement())
  project_id Int
  user_id    Int
  type       NotificationType
  title      String           @db.VarChar(200)
  body       String?
  link       String?          @db.VarChar(300)
  is_read    Boolean          @default(false)
  created_at DateTime         @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read])
  @@map("notifications")
}
