// Profiling 2027 Feedback Portal — Database Schema
// Mirrors Technical Specification v3, Section 3 (Database Schema)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (via PgBouncer/Neon's pooler) — used at runtime
  directUrl = env("DIRECT_URL") // unpooled connection — used for `prisma migrate deploy`
}

enum Role {
  profiler
  group_anchor
  casu_anchor
  casu_lead
  project_lead
  admin
}

enum MappingType {
  peer
}

enum WeekStatus {
  upcoming
  open
  closed
}

enum EvalType {
  self
  peer
}

enum Trajectory {
  improved
  stayed_same
  declined
  not_applicable
}

enum TicketCategory {
  password_email_change
  portal_bug
  feature_not_working
  other
}

enum TicketStatus {
  open
  in_progress
  resolved
}

enum NotificationType {
  ticket_created
  ticket_resolved
  week_opened
  week_closed
  week_opened_admin_summary
  week_closed_admin_summary
  evaluation_unlocked
}

// 3.1.1 projects — one record per annual cycle (Padma 2027, Padma 2028, ...)
model Project {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(100)
  year       Int       @unique
  start_date DateTime  @db.Date
  end_date   DateTime? @db.Date
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())

  users                  User[]
  weeks                  Week[]
  peer_mappings          PeerMapping[]
  peer_mapping_snapshots PeerMappingSnapshot[]
  tickets                Ticket[]
  notifications          Notification[]
  email_broadcasts       EmailBroadcast[]

  @@map("projects")
}

// 3.1.2 users — every professional, lead, anchor, and admin
model User {
  id                   Int       @id @default(autoincrement())
  project_id           Int
  name                 String    @db.VarChar(100)
  email                String    @unique @db.VarChar(150)
  password_hash        String    @db.VarChar(255)
  role                 Role
  // VarChar(255), not a tighter fit to today's longest FIELDS entry (51
  // chars): a CASU Anchor covering more than one field stores them
  // comma-joined in this same column (see utils/fields.js), so it needs
  // headroom for combinations, not just one name.
  field                String?   @db.VarChar(255)
  // Org Employee ID from the team roster — nullable since not everyone has
  // one assigned yet (e.g. new hires pending HR onboarding).
  emp_id               String?   @unique @db.VarChar(20)
  // Text, not VarChar — holds a data: URI (base64) for admin-uploaded photos
  // in the common case, so needs to fit a small compressed image, not just a URL.
  photo_url            String?   @db.Text
  is_active            Boolean   @default(true)
  created_at           DateTime  @default(now())
  // Set the first (and only) time "Send Login Credentials to All" emails
  // this person — lets that bulk action target only people who've never
  // been sent real credentials yet, so adding one new user later doesn't
  // re-reset and re-email everyone who's already set their own password.
  credentials_sent_at  DateTime?
  // Updated on every successful login — lets Admin see who's never signed
  // in at all versus who has.
  last_login_at        DateTime?
  // Updated whenever the password actually changes away from whatever
  // Admin last issued (self-service reset, or Admin's own "Set Password") —
  // distinguishes "still on the temp password" from "has their own now".
  password_changed_at  DateTime?
  // The informal "Master Admin" — always has full access to every Admin
  // Panel section, and is the only one who can grant the can_manage_*
  // flags below to other Admins. Never settable through the app itself
  // (only ever flipped directly in the database), so it can't be
  // escalated to from within the product.
  is_master_admin      Boolean   @default(false)
  // Per-Admin edit access to the three sections a non-master Admin is
  // otherwise view-only in. Irrelevant for every other role, and always
  // implicitly true for is_master_admin regardless of these flags.
  can_manage_weeks     Boolean   @default(false)
  can_manage_passwords Boolean   @default(false)
  can_manage_roster    Boolean   @default(false)
  // Unlike the three flags above (view already granted, only edit is
  // gated), this one gates VIEW access itself: the Compliance Tracker's
  // "Trajectory Mismatches" section (evaluator-vs-scores contradictions)
  // is master-Admin-only by default, since it surfaces judgment calls
  // about specific people's submissions — a non-master Admin only sees it
  // once explicitly granted here. Project Leads and CASU Leads never see
  // it regardless of this flag; it only ever applies to Admin accounts.
  can_view_trajectory_mismatches Boolean @default(false)

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  mappingsAsEvaluator         PeerMapping[]         @relation("MappingEvaluator")
  mappingsAsEvaluatee         PeerMapping[]         @relation("MappingEvaluatee")
  mappingSnapshotsAsEvaluator PeerMappingSnapshot[] @relation("MappingSnapshotEvaluator")
  mappingSnapshotsAsEvaluatee PeerMappingSnapshot[] @relation("MappingSnapshotEvaluatee")
  evaluationsGiven            Evaluation[]          @relation("EvalEvaluator")
  evaluationsReceived         Evaluation[]          @relation("EvalEvaluatee")
  computedScores              ComputedScore[]
  tickets                     Ticket[]
  notifications               Notification[]
  emailBroadcastsSent         EmailBroadcast[]

  @@index([project_id])
  @@map("users")
}

// 3.1.3 peer_mappings — who evaluates whom (digital 'Ideal Mapping' tab)
model PeerMapping {
  id           Int         @id @default(autoincrement())
  project_id   Int
  evaluator_id Int
  evaluatee_id Int
  mapping_type MappingType @default(peer)

  project   Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  evaluator User    @relation("MappingEvaluator", fields: [evaluator_id], references: [id], onDelete: Cascade)
  evaluatee User    @relation("MappingEvaluatee", fields: [evaluatee_id], references: [id], onDelete: Cascade)

  @@unique([project_id, evaluator_id, evaluatee_id])
  @@index([evaluatee_id])
  @@map("peer_mappings")
}

// A frozen, week-scoped copy of peer_mappings, taken the moment a week
// closes. peer_mappings itself is LIVE and global (fully deleted and
// rebuilt on every roster import), so without this, a later reshuffle
// silently rewrites who was ever expected to evaluate whom in an
// already-closed week — exactly what happened to Week 1 here. Once a row
// exists for a (week, evaluator, evaluatee), it's never touched again by a
// later reshuffle; only an explicit Admin correction for that specific
// week (reopen -> re-close) should ever refresh it. The currently OPEN
// week has no rows here yet — reads for an open week still go straight to
// the live peer_mappings table, since its mapping isn't finalized.
model PeerMappingSnapshot {
  id           Int         @id @default(autoincrement())
  project_id   Int
  week_id      Int
  evaluator_id Int
  evaluatee_id Int
  mapping_type MappingType @default(peer)

  project   Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  week      Week    @relation(fields: [week_id], references: [id], onDelete: Cascade)
  evaluator User    @relation("MappingSnapshotEvaluator", fields: [evaluator_id], references: [id], onDelete: Cascade)
  evaluatee User    @relation("MappingSnapshotEvaluatee", fields: [evaluatee_id], references: [id], onDelete: Cascade)

  @@unique([week_id, evaluator_id, evaluatee_id])
  @@index([week_id, evaluatee_id])
  @@map("peer_mapping_snapshots")
}

// 3.1.4 weeks — each feedback cycle; admin opens/closes
model Week {
  id          Int        @id @default(autoincrement())
  project_id  Int
  week_number Int
  label       String     @db.VarChar(20)
  start_date  DateTime   @db.Date
  end_date    DateTime   @db.Date
  status      WeekStatus @default(upcoming)
  // Set the first time this week is closed and never cleared — lets the
  // app tell "opened for the first time" apart from "reopened for a
  // correction" (status alone can't, since both look like "open").
  closed_at   DateTime?

  project              Project               @relation(fields: [project_id], references: [id], onDelete: Cascade)
  evaluations          Evaluation[]
  scores               ComputedScore[]
  peerMappingSnapshots PeerMappingSnapshot[]

  @@unique([project_id, week_number])
  @@map("weeks")
}

// 3.1.5 evaluations — one row per form submission (self or single peer eval)
model Evaluation {
  id                         Int        @id @default(autoincrement())
  week_id                    Int
  evaluator_id               Int
  evaluatee_id               Int
  eval_type                  EvalType
  ownership_discipline       Int        @db.SmallInt
  team_spirit                Int        @db.SmallInt
  communication_clarity      Int        @db.SmallInt
  domain_knowledge           Int        @db.SmallInt
  timeliness_throughput      Int        @db.SmallInt
  work_quality               Int        @db.SmallInt
  problem_solving_initiative Int        @db.SmallInt
  strengths_tags             String[]
  weakness_tags              String[]
  // Free-text detail behind the "Others" strengths/weakness tag — set only
  // when "Others" is among the tags above. "Others" doesn't count toward
  // the normal 3-tag cap, so it's tracked as its own optional add-on rather
  // than folded into the capped tag arrays.
  strengths_other_text       String?    @db.VarChar(200)
  weakness_other_text        String?    @db.VarChar(200)
  improvement_suggestion     String?
  trajectory                 Trajectory
  submitted_at               DateTime   @default(now())
  locked                     Boolean    @default(true)

  week      Week @relation(fields: [week_id], references: [id], onDelete: Cascade)
  evaluator User @relation("EvalEvaluator", fields: [evaluator_id], references: [id], onDelete: Cascade)
  evaluatee User @relation("EvalEvaluatee", fields: [evaluatee_id], references: [id], onDelete: Cascade)

  // one row per (week, evaluator, evaluatee, type) — enforced by the DB, not just app
  // logic, so it can never be duplicated even under concurrent submissions. Every
  // successful write re-locks the row; only an Admin unlock (locked=false) permits
  // the evaluator to submit an edit, which then re-locks it immediately.
  @@unique([week_id, evaluator_id, evaluatee_id, eval_type])
  @@index([week_id, evaluatee_id])
  @@map("evaluations")
}

// 3.1.6 computed_scores — materialised weekly scores, replaces 'Scores for Week XX' tabs
model ComputedScore {
  id                              Int      @id @default(autoincrement())
  week_id                         Int
  user_id                         Int
  ownership_discipline_self       Decimal  @default(0) @db.Decimal(3, 2)
  ownership_discipline_peer       Decimal  @default(0) @db.Decimal(3, 2)
  team_spirit_self                Decimal  @default(0) @db.Decimal(3, 2)
  team_spirit_peer                Decimal  @default(0) @db.Decimal(3, 2)
  communication_clarity_self      Decimal  @default(0) @db.Decimal(3, 2)
  communication_clarity_peer      Decimal  @default(0) @db.Decimal(3, 2)
  domain_knowledge_self           Decimal  @default(0) @db.Decimal(3, 2)
  domain_knowledge_peer           Decimal  @default(0) @db.Decimal(3, 2)
  timeliness_throughput_self      Decimal  @default(0) @db.Decimal(3, 2)
  timeliness_throughput_peer      Decimal  @default(0) @db.Decimal(3, 2)
  work_quality_self               Decimal  @default(0) @db.Decimal(3, 2)
  work_quality_peer               Decimal  @default(0) @db.Decimal(3, 2)
  problem_solving_initiative_self Decimal  @default(0) @db.Decimal(3, 2)
  problem_solving_initiative_peer Decimal  @default(0) @db.Decimal(3, 2)
  total_self                      Decimal  @default(0) @db.Decimal(4, 2)
  total_peer                      Decimal  @default(0) @db.Decimal(5, 2)
  peer_count                      Int      @default(0)
  expected_peer_count             Int      @default(0)
  sapa_factor                     Decimal? @db.Decimal(4, 3)
  computed_at                     DateTime @default(now())
  // Snapshot of the user's field AT THE TIME this week's score was computed
  // — frozen forever once written, so a later team reshuffle (someone
  // moving fields) never silently relabels a past week's Heatmap/SAPA/
  // export row under their new field. Null on rows computed before this
  // column existed; those fall back to the user's current field.
  field                           String?  @db.VarChar(255) // same width as User.field — it's a snapshot of that column

  week Week @relation(fields: [week_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([week_id, user_id])
  @@map("computed_scores")
}

// Grievance Redressal — "Raise Your Concern" tickets any non-admin user can
// file (password/email changes, portal bugs, feature issues, or anything
// else); Admin triages and responds from the Grievances tab.
model Ticket {
  id             Int            @id @default(autoincrement())
  project_id     Int
  user_id        Int
  category       TicketCategory
  subject        String         @db.VarChar(200)
  description    String
  status         TicketStatus   @default(open)
  admin_response String?
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  resolved_at    DateTime?

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([project_id, status])
  @@index([user_id])
  @@map("tickets")
}

// Bell-icon notifications — Admin gets one per new ticket, everyone gets one
// when a week opens/closes, and a ticket's filer gets one when it's resolved.
model Notification {
  id         Int              @id @default(autoincrement())
  project_id Int
  user_id    Int
  type       NotificationType
  title      String           @db.VarChar(200)
  body       String?
  link       String?          @db.VarChar(300)
  is_read    Boolean          @default(false)
  created_at DateTime         @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read])
  @@map("notifications")
}

// Admin "send an email on any topic" — a free-form broadcast to all users,
// a role, a field, or a hand-picked list, kept as a sent-history log so
// Admins can see what's already gone out (and to whom) before sending
// another. Available to every Admin, unlike the Master-Admin-gated
// can_manage_* sections above.
model EmailBroadcast {
  id                Int      @id @default(autoincrement())
  project_id        Int
  sender_id         Int
  subject           String   @db.VarChar(200)
  body_html         String
  // Human-readable description of who this went to (e.g. "All active users",
  // "Profilers", "Arts field", "3 individually selected users") — computed
  // once at send time so the log stays meaningful even if the roster changes later.
  recipient_summary String   @db.VarChar(300)
  recipient_count   Int
  sent_count        Int
  created_at        DateTime @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@map("email_broadcasts")
}
