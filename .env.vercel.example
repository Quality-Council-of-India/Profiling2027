# Environment variables to set in the Vercel dashboard
# (Project → Settings → Environment Variables), not committed as a real .env.
# CORS_ORIGIN is intentionally omitted — frontend and API share one origin
# on Vercel, so no cross-origin requests happen.

# From your Postgres provider (Neon, Vercel Postgres, Supabase, ...):
# DATABASE_URL = the POOLED connection string (used at runtime by every request)
# DIRECT_URL   = the UNPOOLED/direct connection string (used only by `prisma migrate deploy` at build time)
DATABASE_URL=postgresql://user:password@pooler-host/dbname?sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://user:password@direct-host/dbname?sslmode=require

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Profiling 2027 Feedback Portal <no-reply@qcin.org>

# Shields /api/cron/reminders from being triggered by anyone who finds the URL —
# Vercel automatically sends this as a Bearer token when it fires the Cron Job.
CRON_SECRET=replace-with-a-long-random-secret
